# Supabase — already configured in .env.local for the existing auth setup.
# These are PUBLIC (exposed to the browser) and safe to ship.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Pro test bypass — comma-separated emails that always resolve as Pro regardless
# of DB state. Server-side only. Add your dev/test account here so you can test
# the Pro UX without a real Stripe/Digistore subscription.
# PRO_TEST_EMAILS=you@example.com,other@example.com

# Anthropic — used by /api/scan (Haiku verdict + Sonnet vision identify)
# and /api/listing (Haiku FB-listing copy). Claude handles all pricing
# intelligence — no eBay or other comps API needed. Server-side only.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...
